{
    "version": "1.0.0",
    "layout_name": "plugin_settings",
    "permissions": [
        "core.plugins.update"
    ],
    "extends": "_admin_base",
    "meta": {
        "title": "$t:sirsoft-message_bizppurio.settings.title",
        "description": "$t:sirsoft-message_bizppurio.settings.description"
    },
    "data_sources": [
        {
            "id": "settings",
            "type": "api",
            "endpoint": "/api/admin/plugins/{{route.identifier}}/settings",
            "method": "GET",
            "auto_fetch": true,
            "auth_required": true,
            "initLocal": "form",
            "refetchOnMount": true
        }
    ],
    "slots": {
        "content": [
            {
                "id": "plugin_settings_content",
                "type": "basic",
                "name": "Div",
                "dataKey": "form",
                "trackChanges": true,
                "props": {
                    "className": "p-4 sm:p-6 lg:p-8 min-h-screen bg-gray-50 dark:bg-gray-900"
                },
                "children": [
                    {
                        "id": "page_header",
                        "type": "composite",
                        "name": "PageHeader",
                        "props": {
                            "title": "$t:sirsoft-message_bizppurio.settings.title",
                            "description": "$t:sirsoft-message_bizppurio.settings.description",
                            "backPath": "/admin/plugins",
                            "backLabel": "$t:admin.plugins.back_to_list"
                        }
                    },
                    {
                        "id": "validation_error",
                        "type": "basic",
                        "name": "Div",
                        "if": "{{_local.errors}}",
                        "props": {
                            "id": "bizppurio_settings_validation_error",
                            "role": "alert",
                            "aria-live": "assertive",
                            "tabIndex": -1,
                            "className": "alert-danger scroll-mt-32"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "flex gap-3"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Icon",
                                        "props": {
                                            "name": "triangle-exclamation",
                                            "size": "md",
                                            "className": "text-red-600 dark:text-red-400 flex-shrink-0 mt-0.5"
                                        }
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Div",
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "H3",
                                                "props": {
                                                    "className": "text-error-soft"
                                                },
                                                "text": "$t:admin.plugins.settings.validation_error"
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Ul",
                                                "if": "{{typeof _local.errors === 'object' && Object.keys(_local.errors).length > 0}}",
                                                "props": {
                                                    "className": "mt-2 list-disc list-inside space-y-1"
                                                },
                                                "iteration": {
                                                    "source": "Object.entries(_local.errors ?? {}).flatMap(([field, messages]) => Array.isArray(messages) ? messages : [messages])",
                                                    "item_var": "message"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Li",
                                                        "text": "{{message}}"
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section_api",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                            "className": "mt-6 bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "px-6 py-4 border-b border-gray-200 dark:border-gray-700"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "H3",
                                        "props": {
                                            "className": "text-base font-semibold text-gray-900 dark:text-gray-100"
                                        },
                                        "text": "$t:sirsoft-message_bizppurio.settings.sections.api.title"
                                    },
                                    {
                                        "type": "basic",
                                        "name": "P",
                                        "props": {
                                            "className": "form-hint"
                                        },
                                        "text": "$t:sirsoft-message_bizppurio.settings.sections.api.description"
                                    }
                                ]
                            },
                            {
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "p-6 space-y-6"
                                },
                                "children": [
                                    {
                                        "id": "field_environment",
                                        "type": "basic",
                                        "name": "Div",
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Label",
                                                "props": {
                                                    "className": "form-label"
                                                },
                                                "text": "$t:sirsoft-message_bizppurio.settings.fields.environment.label"
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Select",
                                                "props": {
                                                    "name": "environment",
                                                    "className": "input mt-1"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Option",
                                                        "props": {
                                                            "value": "dev"
                                                        },
                                                        "text": "$t:sirsoft-message_bizppurio.settings.fields.environment.option_dev"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "Option",
                                                        "props": {
                                                            "value": "live"
                                                        },
                                                        "text": "$t:sirsoft-message_bizppurio.settings.fields.environment.option_live"
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "basic",
                                                "name": "P",
                                                "props": {
                                                    "className": "form-hint mt-1"
                                                },
                                                "text": "$t:sirsoft-message_bizppurio.settings.fields.environment.hint"
                                            }
                                        ]
                                    },
                                    {
                                        "id": "field_bizppurio_id",
                                        "type": "basic",
                                        "name": "Div",
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Label",
                                                "props": {
                                                    "className": "form-label"
                                                },
                                                "text": "$t:sirsoft-message_bizppurio.settings.fields.bizppurio_id.label"
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Input",
                                                "props": {
                                                    "type": "text",
                                                    "name": "bizppurio_id",
                                                    "autoComplete": "off",
                                                    "className": "input mt-1"
                                                }
                                            },
                                            {
                                                "type": "basic",
                                                "name": "P",
                                                "props": {
                                                    "className": "form-hint mt-1"
                                                },
                                                "text": "$t:sirsoft-message_bizppurio.settings.fields.bizppurio_id.hint"
                                            }
                                        ]
                                    },
                                    {
                                        "id": "field_password",
                                        "type": "basic",
                                        "name": "Div",
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Label",
                                                "props": {
                                                    "className": "form-label"
                                                },
                                                "text": "$t:sirsoft-message_bizppurio.settings.fields.password.label"
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Input",
                                                "props": {
                                                    "type": "password",
                                                    "name": "password",
                                                    "autoComplete": "new-password",
                                                    "placeholder": "••••••••",
                                                    "className": "input mt-1 font-mono"
                                                }
                                            },
                                            {
                                                "type": "basic",
                                                "name": "P",
                                                "props": {
                                                    "className": "form-hint mt-1"
                                                },
                                                "text": "$t:sirsoft-message_bizppurio.settings.fields.password.hint"
                                            }
                                        ]
                                    },
                                    {
                                        "id": "field_api_key",
                                        "type": "basic",
                                        "name": "Div",
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Label",
                                                "props": {
                                                    "className": "form-label"
                                                },
                                                "text": "$t:sirsoft-message_bizppurio.settings.fields.api_key.label"
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Input",
                                                "props": {
                                                    "type": "password",
                                                    "name": "api_key",
                                                    "autoComplete": "new-password",
                                                    "placeholder": "••••••••",
                                                    "className": "input mt-1 font-mono"
                                                }
                                            },
                                            {
                                                "type": "basic",
                                                "name": "P",
                                                "props": {
                                                    "className": "form-hint mt-1"
                                                },
                                                "text": "$t:sirsoft-message_bizppurio.settings.fields.api_key.hint"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section_sending",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                            "className": "mt-6 bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "px-6 py-4 border-b border-gray-200 dark:border-gray-700"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "H3",
                                        "props": {
                                            "className": "text-base font-semibold text-gray-900 dark:text-gray-100"
                                        },
                                        "text": "$t:sirsoft-message_bizppurio.settings.sections.sending.title"
                                    },
                                    {
                                        "type": "basic",
                                        "name": "P",
                                        "props": {
                                            "className": "form-hint"
                                        },
                                        "text": "$t:sirsoft-message_bizppurio.settings.sections.sending.description"
                                    }
                                ]
                            },
                            {
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "p-6 space-y-6"
                                },
                                "children": [
                                    {
                                        "id": "field_sender_number",
                                        "type": "basic",
                                        "name": "Div",
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Label",
                                                "props": {
                                                    "className": "form-label"
                                                },
                                                "text": "$t:sirsoft-message_bizppurio.settings.fields.sender_number.label"
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Input",
                                                "props": {
                                                    "type": "text",
                                                    "name": "sender_number",
                                                    "autoComplete": "off",
                                                    "className": "input mt-1"
                                                }
                                            },
                                            {
                                                "type": "basic",
                                                "name": "P",
                                                "props": {
                                                    "className": "form-hint mt-1"
                                                },
                                                "text": "$t:sirsoft-message_bizppurio.settings.fields.sender_number.hint"
                                            }
                                        ]
                                    },
                                    {
                                        "id": "field_sender_key",
                                        "type": "basic",
                                        "name": "Div",
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Label",
                                                "props": {
                                                    "className": "form-label"
                                                },
                                                "text": "$t:sirsoft-message_bizppurio.settings.fields.sender_key.label"
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Input",
                                                "props": {
                                                    "type": "password",
                                                    "name": "sender_key",
                                                    "autoComplete": "new-password",
                                                    "placeholder": "••••••••",
                                                    "className": "input mt-1 font-mono"
                                                }
                                            },
                                            {
                                                "type": "basic",
                                                "name": "P",
                                                "props": {
                                                    "className": "form-hint mt-1"
                                                },
                                                "text": "$t:sirsoft-message_bizppurio.settings.fields.sender_key.hint"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section_integration",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                            "className": "mt-6 bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "px-6 py-4 border-b border-gray-200 dark:border-gray-700"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "H3",
                                        "props": {
                                            "className": "text-base font-semibold text-gray-900 dark:text-gray-100"
                                        },
                                        "text": "$t:sirsoft-message_bizppurio.settings.sections.integration.title"
                                    },
                                    {
                                        "type": "basic",
                                        "name": "P",
                                        "props": {
                                            "className": "form-hint"
                                        },
                                        "text": "$t:sirsoft-message_bizppurio.settings.sections.integration.description"
                                    }
                                ]
                            },
                            {
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "p-6 space-y-2"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Label",
                                        "props": {
                                            "className": "form-label"
                                        },
                                        "text": "$t:sirsoft-message_bizppurio.settings.webhook.label"
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "flex gap-2"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Input",
                                                "props": {
                                                    "type": "text",
                                                    "readOnly": true,
                                                    "value": "/api/plugins/sirsoft-message_bizppurio/webhook",
                                                    "className": "input flex-1 font-mono text-sm bg-gray-50 dark:bg-gray-900"
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "type": "basic",
                                        "name": "P",
                                        "props": {
                                            "className": "form-hint"
                                        },
                                        "text": "$t:sirsoft-message_bizppurio.settings.webhook.hint"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "footer_buttons",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                            "className": "sticky bottom-0 z-10 flex justify-end items-center gap-3 mt-6 px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg dark:bg-gray-800 dark:border-gray-700"
                        },
                        "children": [
                            {
                                "id": "cancel_button",
                                "type": "basic",
                                "name": "Button",
                                "props": {
                                    "type": "button",
                                    "className": "btn btn-secondary"
                                },
                                "actions": [
                                    {
                                        "type": "click",
                                        "handler": "navigate",
                                        "params": {
                                            "path": "/admin/plugins"
                                        }
                                    }
                                ],
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "text": "$t:common.cancel"
                                    }
                                ]
                            },
                            {
                                "id": "save_button",
                                "type": "basic",
                                "name": "Button",
                                "props": {
                                    "type": "button",
                                    "disabled": "{{!_local.hasChanges || _local.isSaving}}",
                                    "className": "btn btn-primary flex-center gap-1.5"
                                },
                                "actions": [
                                    {
                                        "type": "click",
                                        "handler": "sequence",
                                        "actions": [
                                            {
                                                "handler": "setState",
                                                "params": {
                                                    "target": "local",
                                                    "isSaving": true,
                                                    "errors": null
                                                }
                                            },
                                            {
                                                "handler": "apiCall",
                                                "auth_required": true,
                                                "target": "/api/admin/plugins/{{route.identifier}}/settings",
                                                "params": {
                                                    "method": "PUT",
                                                    "body": "{{_local.form}}"
                                                },
                                                "onSuccess": [
                                                    {
                                                        "handler": "setState",
                                                        "params": {
                                                            "target": "local",
                                                            "isSaving": false,
                                                            "hasChanges": false
                                                        }
                                                    },
                                                    {
                                                        "handler": "toast",
                                                        "params": {
                                                            "type": "success",
                                                            "message": "$t:admin.plugins.settings.save_success"
                                                        }
                                                    },
                                                    {
                                                        "handler": "refetchDataSource",
                                                        "params": {
                                                            "dataSourceId": "settings"
                                                        }
                                                    }
                                                ],
                                                "onError": [
                                                    {
                                                        "handler": "setState",
                                                        "params": {
                                                            "target": "local",
                                                            "isSaving": false,
                                                            "errors": "{{error.errors ?? { _general: error.message }}}"
                                                        }
                                                    },
                                                    {
                                                        "handler": "scrollIntoView",
                                                        "params": {
                                                            "selector": "#bizppurio_settings_validation_error",
                                                            "behavior": "smooth",
                                                            "block": "start",
                                                            "waitForElement": true,
                                                            "timeout": 2000
                                                        }
                                                    },
                                                    {
                                                        "handler": "toast",
                                                        "params": {
                                                            "type": "error",
                                                            "message": "$t:admin.plugins.settings.save_error"
                                                        }
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ],
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Icon",
                                        "if": "{{_local.isSaving}}",
                                        "props": {
                                            "name": "spinner",
                                            "className": "spinner-sm"
                                        }
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "if": "{{!_local.isSaving}}",
                                        "text": "$t:common.save"
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "if": "{{_local.isSaving}}",
                                        "text": "$t:common.saving"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
